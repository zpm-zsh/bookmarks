#!/usr/bin/env zsh

# Delete a bookmark
local bookmark_file="$(<"$ZPM_BOOKMARKS_FILE")"

if [[ -z "$1" ]]; then
  local p="$(print -D $PWD)"
  if ! awk -F'|' -v p="$p" '$1 == p {found=1; exit} END {exit !found}' <<< "$bookmark_file"; then
    echo "'$p' not found in your bookmarks, skipping."
  else
    bookmark_file="$(awk -F'|' -v p="$p" '$1 != p' <<< "$bookmark_file")"
  fi
else
  for bookmark_name in "$@"; do
    if ! awk -F'|' -v n="$bookmark_name" '$2 == n {found=1; exit} END {exit !found}' <<< "$bookmark_file"; then
      echo "'${bookmark_name}' not found in your bookmarks, skipping."
    else
      bookmark_file="$(awk -F'|' -v n="$bookmark_name" '$2 != n' <<< "$bookmark_file")"
    fi
  done
fi

# Write back without trailing newlines inserted by command substitution
printf '%s\n' "${bookmark_file}" | sed '/^$/d' >! "$ZPM_BOOKMARKS_FILE"
